# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API Keys.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose to the browser:
# it's only used to listen for realtime updates.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY — never commit or share it.
SUPABASE_SECRET_KEY=
